# Server configuration. Copy to .env and fill in.
# .env is gitignored - never commit real values.

# Postgres connection
PGHOST=db
PGPORT=5432
PGDATABASE=garagemaster
PGUSER=postgres
PGPASSWORD=change-me

# Web container
PORT=4000

# Set to true when running behind HTTPS (reverse proxy or direct).
# Enables HSTS, redirects http->https, and marks session cookies Secure.
FORCE_HTTPS=false
COOKIE_SECURE=false
